# Leuco live demo defaults. Copy into .env and adjust locally if needed.

LEUCO_HTTP_HOST=0.0.0.0
LEUCO_HTTP_PORT=8080
LEUCO_LOG_LEVEL=INFO

# mock, video, or rtsp
LEUCO_SOURCE=mock
LEUCO_MOCK_SCENARIO=normal
LEUCO_VIDEO_PATH=
LEUCO_RTSP_BACKEND=auto
# auto tries GStreamer candidates first, then OpenCV direct RTSP open.
LEUCO_GSTREAMER_PIPELINE=auto
# auto tries H.264/H.265/decodebin with forced TCP before default RTSP transport.

# mock, yolo_pose, or motion_box
LEUCO_INFERENCE_BACKEND=mock
LEUCO_MODEL_PATH=/mnt/ssd/models/leuco/yolo11n-pose.pt

# Optional x1,y1,x2,y2 crop used only for inference. Use disabled or empty for full-frame.
# Screenshot starting point for the current high/wide pool view: 300,220,1080,670
LEUCO_INFERENCE_ROI=
# Set this when the ROI was chosen from a screenshot with a different size than the RTSP stream.
LEUCO_INFERENCE_ROI_REFERENCE_SIZE=

# Stub-only for this phase: disabled or full_frame_stub.
LEUCO_POOL_GATE=disabled

LEUCO_AI_FPS=8
LEUCO_DECISION_WINDOW_SECONDS=6
LEUCO_HIGH_RISK_FRAMES=34
LEUCO_ALERT_COOLDOWN_SECONDS=60

# Keep disabled during local smoke tests. Set to 1 for the staged ntfy demo.
LEUCO_ALERTS_ENABLED=0
LEUCO_NTFY_URL=https://ntfy.sh/leuco
LEUCO_NTFY_TITLE=Leuco demo alert
